---
import ResaleLayout from '../../../layouts/ResaleLayout.astro';
import { STATUSES, getItem, money } from '../../../lib/items';
import { PLATFORMS, estimatePayout } from '../../../lib/platforms';

const id = Number(Astro.params.id);
const item = Number.isInteger(id) ? await getItem(id) : null;
if (!item) return new Response('Item not found', { status: 404 });

const drafts: { platform: string; title: string; description: string }[] = JSON.parse(item.drafts_json);
const price = item.listed_price ?? item.suggested_price ?? 0;
---

<ResaleLayout title={item.item_name}>
  <div class="grid sm:grid-cols-[200px_1fr] gap-6">
    <img
      src={`/api/resale/photo/${item.photo_key}`}
      alt={item.item_name}
      class="w-full rounded border border-ink/10"
    />
    <div>
      <h1 class="font-display text-2xl font-bold">{item.item_name}</h1>
      <p class="text-ink/70">
        {[item.brand, item.category].filter(Boolean).join(' · ')}
      </p>
      <p class="mt-2 text-sm"><span class="font-semibold">Condition:</span> {item.condition}</p>
      <p class="mt-3 text-3xl font-display font-bold">{money(item.suggested_price)}</p>
      <p class="text-sm text-ink/70">
        Range {money(item.price_low)}–{money(item.price_high)}. {item.price_reasoning}
      </p>
    </div>
  </div>

  <h2 class="font-display text-xl font-bold mt-8">Listing drafts</h2>
  <div class="mt-3 space-y-4">
    {PLATFORMS.map((p) => {
      const d = drafts.find((x) => x.platform === p.id);
      if (!d) return null;
      return (
        <section class="rounded border border-ink/10 bg-white p-4">
          <div class="flex items-baseline justify-between gap-2">
            <h3 class="font-semibold">{p.name}</h3>
            <span class="text-xs text-ink/60">
              ≈ {money(estimatePayout(p, price))} after fees at {money(price)}
            </span>
          </div>
          <div class="mt-2 flex gap-2 items-start">
            <p class="flex-1 font-medium" data-copy-src>{d.title}</p>
            <button type="button" class="copy text-xs text-coral hover:underline">Copy title</button>
          </div>
          <div class="mt-2 flex gap-2 items-start">
            <p class="flex-1 text-sm whitespace-pre-line" data-copy-src>{d.description}</p>
            <button type="button" class="copy text-xs text-coral hover:underline">Copy text</button>
          </div>
          <p class="mt-2 text-xs text-ink/50">{p.feeSummary} Fee estimate {p.feesCheckedOn === 'unverified' ? 'not yet verified' : `checked ${p.feesCheckedOn}`}.</p>
        </section>
      );
    })}
  </div>

  <h2 class="font-display text-xl font-bold mt-8">Track it</h2>
  <form method="post" action={`/api/resale/items/${item.id}`} class="mt-3 grid sm:grid-cols-2 gap-3 text-sm">
    <label>Status
      <select name="status" class="mt-1 w-full rounded border border-ink/20 px-2 py-1.5">
        {STATUSES.map((s) => <option value={s} selected={s === item.status}>{s}</option>)}
      </select>
    </label>
    <label>Platform
      <select name="platform" class="mt-1 w-full rounded border border-ink/20 px-2 py-1.5">
        <option value="">—</option>
        {PLATFORMS.map((p) => <option value={p.id} selected={p.id === item.platform}>{p.name}</option>)}
      </select>
    </label>
    <label>Listed price
      <input name="listed_price" inputmode="decimal" value={item.listed_price ?? ''} class="mt-1 w-full rounded border border-ink/20 px-2 py-1.5" />
    </label>
    <label>Sold for (if sold)
      <input name="sold_price" inputmode="decimal" value={item.sold_price ?? ''} class="mt-1 w-full rounded border border-ink/20 px-2 py-1.5" />
    </label>
    <div class="sm:col-span-2 flex gap-3">
      <button class="rounded-full bg-coral hover:bg-coral-dark text-white font-semibold px-5 py-2">Save</button>
      <button name="action" value="delete" formnovalidate class="text-ink/60 hover:text-coral-dark"
        onclick="return confirm('Delete this item and its photo?')">Delete item</button>
    </div>
  </form>
</ResaleLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('button.copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const src = btn.parentElement?.querySelector('[data-copy-src]');
      if (!src) return;
      await navigator.clipboard.writeText(src.textContent ?? '');
      const label = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => (btn.textContent = label), 1500);
    });
  });
</script>
