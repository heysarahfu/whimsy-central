---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <div class="max-w-xl mx-auto px-4 sm:px-6 py-24 text-center">
    <div class="text-6xl">🧭</div>
    <h1 class="font-display text-3xl sm:text-4xl font-bold text-ink mt-4">
      Well, this is delightfully lost.
    </h1>
    <p class="mt-3 text-ink/70">
      We couldn't find that page. Maybe it wandered off in search of
      something beautiful.
    </p>
    <a
      href="/"
      class="mt-6 inline-block font-display font-semibold bg-coral hover:bg-coral-dark text-white rounded-full px-6 py-2.5 transition-colors"
    >
      Back to Whimsy Central
    </a>
  </div>
</BaseLayout>
