---
interface Props {
  emoji?: string;
  label: string;
  description: string;
}

const { emoji, label, description } = Astro.props;
---

<div class="max-w-5xl mx-auto px-4 sm:px-6 pt-10 pb-6 text-center">
  <h1 class="font-display text-4xl sm:text-5xl font-bold text-ink">
    {emoji} {label}
  </h1>
  <p class="mt-3 text-lg text-ink/70 max-w-2xl mx-auto">{description}</p>
</div>
